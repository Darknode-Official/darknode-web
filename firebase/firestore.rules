rules_version = '2';
// Darknode Web - multi-user Firestore rules. Anyone can sign up and use the site;
// each user owns their own doc. The single super-admin is identified by a Firebase
// custom claim (admin:true), set out-of-band by scripts/set-admin.mjs — there is no
// admin email hardcoded in the rules or the shipped client. Deploy via the Firebase
// console (Firestore -> Rules) or the Firebase CLI.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email()    { return request.auth.token.email; }
    function isOwner()  { return signedIn() && request.auth.token.admin == true; }
    // A non-owner client may never stamp privilege fields onto a user doc.
    function noPrivEscalation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'role', 'tier', 'entitlements']);
    }

    // Each user reads/writes only their own doc; the owner can read/manage all.
    // Only the Admin SDK (set-admin.mjs) may set the admin/role privilege fields;
    // a user updating their own doc cannot add or change them.
    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.email == email()
                    && !request.resource.data.keys().hasAny(['admin', 'role', 'tier', 'entitlements']);
      allow update: if isOwner()
                    || (request.auth.uid == uid
                        && request.resource.data.email == email()
                        && noPrivEscalation());
      allow delete: if isOwner();
    }

    // Nexus CLI pairing codes: a signed-in user may create a one-time code ONLY
    // for their own account. No client may read, list, or update a code — it is
    // consumed server-side by the exchange endpoint (Admin SDK bypasses rules).
    // The user may delete their own pending code (e.g. to cancel it).
    match /pairings/{code} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == email();
      allow read, list, update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Announcements + settings: any signed-in user reads; only the owner writes.
    match /announcements/{docId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }
    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // Feedback / bug reports: any signed-in user submits one for their own uid.
    // Shape + size are validated so a doc can't be stuffed with arbitrary fields
    // or oversized payloads. Only the owner reads & manages.
    match /feedback/{docId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['type','message','email','uid','ts','userAgent','url','resolved'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 4001
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 40
                    && (!('url' in request.resource.data)
                        || request.resource.data.url.size() <= 2048)
                    && (!('userAgent' in request.resource.data)
                        || request.resource.data.userAgent.size() <= 1024)
                    && (!('email' in request.resource.data)
                        || request.resource.data.email.size() <= 256);
      allow read, update, delete: if isOwner();
    }

    // Client error log: a signed-in user reports errors for their own uid. The
    // shape is dynamic (stack/source/line vary), so bind the uid and cap the
    // largest string fields rather than fixing an exact key set.
    match /errors/{docId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && (!('message' in request.resource.data)
                        || (request.resource.data.message is string
                            && request.resource.data.message.size() <= 8192))
                    && (!('stack' in request.resource.data)
                        || (request.resource.data.stack is string
                            && request.resource.data.stack.size() <= 16384));
      allow read, update, delete: if isOwner();
    }

    // Waitlist: anyone can submit their email (landing page, not signed in).
    // Only owner can read/manage. Limit fields to prevent abuse.
    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 256;
      allow read, update, delete: if isOwner();
    }

    // Beta Lab demo tools: a PUBLIC catalogue of prototype/concept demos, published
    // by the owner (normally via the Admin SDK, which bypasses rules) so new demos
    // appear live without a site redeploy. Anyone may read; only the owner writes.
    match /demoTools/{docId} {
      allow read:  if true;
      allow write: if isOwner();
    }

    // Beta Lab tool requests: a PUBLIC request board. Anyone (signed in or not) may
    // post one idea; their name + idea are shown publicly. Shape + size are pinned
    // so a doc can't be stuffed with extra fields or oversized payloads. Only the
    // owner may edit or remove entries.
    match /toolRequests/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'idea', 'uid', 'ts', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.idea is string
                    && request.resource.data.idea.size() >= 3
                    && request.resource.data.idea.size() <= 280
                    && request.resource.data.ts is int
                    && (request.resource.data.uid == null
                        || (request.resource.data.uid is string
                            && request.resource.data.uid == request.auth.uid));
      allow update, delete: if isOwner();
    }

    // Plan upgrade requests. A signed-in user may file a request for their OWN uid,
    // always status 'pending' — they can never set a tier on themselves (that lives on
    // the user doc and is owner-only). The owner reads, grants (update) or clears them.
    match /upgradeRequests/{rid} {
      allow read:   if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'tier', 'note', 'status', 'ts'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.tier is string
                    && request.resource.data.tier.size() <= 20
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 2000;
      allow update, delete: if isOwner();
    }

    // Per-user notifications: durable, account-level messages (e.g. a plan upgrade was
    // granted). These are low-volume account events — NOT the chatty local activity feed,
    // which stays per-browser. Only the owner writes them (unread); the user reads their
    // own and may only flip `read` to true. Either side may delete.
    match /users/{uid}/notifications/{nid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(['text', 'kind', 'ts', 'read'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.kind is string
                    && request.resource.data.kind.size() <= 40
                    && request.resource.data.ts is int
                    && request.resource.data.read == false;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
    }

    // VAULT team vaults. Firestore holds WHO is in a vault and their role; the money
    // itself (ledger, transfers, approvals, audit) lives in the worker's VaultDO, which
    // reads the caller's member doc with the caller's own token. So these rules are what
    // stop anyone granting themselves a role:
    //   - a vault is founded in one batch: vault doc + founder's owner member doc + log;
    //   - after that only an owner writes member docs, never their own;
    //   - every member write carries a logId, and the matching memberLog entry must be
    //     written in the same batch (create-only), so role changes always leave a trail;
    //   - nothing is ever deleted; removal is role 'removed'.
    function vPath(vid)      { return /databases/$(database)/documents/vaults/$(vid); }
    function vRole(vid)      { return get(/databases/$(database)/documents/vaults/$(vid)/members/$(request.auth.uid)).data.role; }
    function vMember(vid)    { return signedIn() && exists(/databases/$(database)/documents/vaults/$(vid)/members/$(request.auth.uid)) && vRole(vid) != 'removed'; }
    function vOwner(vid)     { return vMember(vid) && vRole(vid) == 'owner'; }
    function vFounding(vid)  { return !exists(vPath(vid)) && getAfter(vPath(vid)).data.createdBy == request.auth.uid; }

    match /vaults/{vid} {
      allow read: if vMember(vid);
      allow create: if signedIn()
                    && vid.matches('^[A-Za-z0-9_-]{8,40}$')
                    && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && getAfter(/databases/$(database)/documents/vaults/$(vid)/members/$(request.auth.uid)).data.role == 'owner';
      allow update: if vOwner(vid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80;
      allow delete: if false;

      match /members/{uid} {
        allow read: if vMember(vid) || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'role', 'by', 'ts', 'logId', 'label'])
                    && request.resource.data.uid == uid
                    && (!('label' in request.resource.data)
                        || (request.resource.data.label is string && request.resource.data.label.size() <= 120))
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.ts == request.time
                    && request.resource.data.role in ['owner', 'admin', 'initiator', 'approver', 'auditor', 'viewer', 'removed']
                    && request.resource.data.logId is string
                    && request.resource.data.logId.size() <= 40
                    && !exists(/databases/$(database)/documents/vaults/$(vid)/memberLog/$(request.resource.data.logId))
                    && getAfter(/databases/$(database)/documents/vaults/$(vid)/memberLog/$(request.resource.data.logId)).data.by == request.auth.uid
                    && getAfter(/databases/$(database)/documents/vaults/$(vid)/memberLog/$(request.resource.data.logId)).data.uid == uid
                    && getAfter(/databases/$(database)/documents/vaults/$(vid)/memberLog/$(request.resource.data.logId)).data.role == request.resource.data.role
                    && ((vFounding(vid) && uid == request.auth.uid && request.resource.data.role == 'owner')
                        || (vOwner(vid) && uid != request.auth.uid));
        allow delete: if false;
      }

      match /memberLog/{logId} {
        allow read: if vMember(vid);
        allow create: if signedIn()
                    && logId.matches('^[A-Za-z0-9_-]{8,40}$')
                    && !exists(/databases/$(database)/documents/vaults/$(vid)/memberLog/$(logId))
                    && request.resource.data.keys().hasOnly(['uid', 'role', 'by', 'ts'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.ts == request.time
                    && getAfter(/databases/$(database)/documents/vaults/$(vid)/members/$(request.resource.data.uid)).data.logId == logId;
        allow update, delete: if false;
      }
    }

    // Team workspaces (Phase B2) — the non-financial generalization of the vaults block
    // above. Firestore holds WHO is in a workspace and their role; the shared security
    // graph itself lives in the worker's GraphDO (worker/graph.js), which reads the
    // caller's member doc with their own token. These rules are what stop anyone granting
    // themselves a role:
    //   - a workspace is founded in one batch: workspace doc + founder owner member + log;
    //   - after that an owner OR admin writes member docs, never for themselves, and only
    //     an owner may mint an owner or admin (an admin may set analyst/responder/viewer);
    //   - every member write carries a logId whose matching memberLog entry is written in
    //     the same batch (create-only), so role changes always leave a trail;
    //   - nothing is deleted; removal is role 'removed'.
    // A PERSONAL workspace (the Phase B1 graph) has NO doc here: its id is the owner's own
    // uid and the worker treats them as implicit owner, so personal sync needs no rule.
    function wPath(wid)     { return /databases/$(database)/documents/workspaces/$(wid); }
    function wRole(wid)     { return get(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid)).data.role; }
    function wMember(wid)   { return signedIn() && exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid)) && wRole(wid) != 'removed'; }
    function wOwner(wid)    { return wMember(wid) && wRole(wid) == 'owner'; }
    function wManager(wid)  { return wMember(wid) && (wRole(wid) == 'owner' || wRole(wid) == 'admin'); }
    function wFounding(wid) { return !exists(wPath(wid)) && getAfter(wPath(wid)).data.createdBy == request.auth.uid; }

    match /workspaces/{wid} {
      allow read: if wMember(wid);
      allow create: if signedIn()
                    && wid.matches('^[A-Za-z0-9_-]{8,40}$')
                    && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && getAfter(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid)).data.role == 'owner';
      allow update: if wManager(wid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80;
      allow delete: if false;

      match /members/{uid} {
        allow read: if wMember(wid) || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'role', 'by', 'ts', 'logId', 'label'])
                    && request.resource.data.uid == uid
                    && (!('label' in request.resource.data)
                        || (request.resource.data.label is string && request.resource.data.label.size() <= 120))
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.ts == request.time
                    && request.resource.data.role in ['owner', 'admin', 'analyst', 'responder', 'viewer', 'removed']
                    && request.resource.data.logId is string
                    && request.resource.data.logId.size() <= 40
                    && !exists(/databases/$(database)/documents/workspaces/$(wid)/memberLog/$(request.resource.data.logId))
                    && getAfter(/databases/$(database)/documents/workspaces/$(wid)/memberLog/$(request.resource.data.logId)).data.by == request.auth.uid
                    && getAfter(/databases/$(database)/documents/workspaces/$(wid)/memberLog/$(request.resource.data.logId)).data.uid == uid
                    && getAfter(/databases/$(database)/documents/workspaces/$(wid)/memberLog/$(request.resource.data.logId)).data.role == request.resource.data.role
                    && ((wFounding(wid) && uid == request.auth.uid && request.resource.data.role == 'owner')
                        || (wManager(wid) && uid != request.auth.uid
                            && (wOwner(wid) || (request.resource.data.role != 'owner' && request.resource.data.role != 'admin'))));
        allow delete: if false;
      }

      match /memberLog/{logId} {
        allow read: if wMember(wid);
        allow create: if signedIn()
                    && logId.matches('^[A-Za-z0-9_-]{8,40}$')
                    && !exists(/databases/$(database)/documents/workspaces/$(wid)/memberLog/$(logId))
                    && request.resource.data.keys().hasOnly(['uid', 'role', 'by', 'ts'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.ts == request.time
                    && getAfter(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.resource.data.uid)).data.logId == logId;
        allow update, delete: if false;
      }
    }

    // "Which vaults or workspaces am I in?" — a collection-group query over member docs,
    // limited to the caller's own entries. Covers both vaults/ and workspaces/ members.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
