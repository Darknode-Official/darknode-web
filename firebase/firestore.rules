rules_version = '2';
// Sentinel Web - multi-user Firestore rules. Anyone can sign up and use the site;
// each user owns their own doc. Owner (cashzombs@gmail.com) is admin. Deploy via
// the Firebase console (Firestore -> Rules) or the Firebase CLI.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email()    { return request.auth.token.email; }
    function isOwner()  { return signedIn() && email() == 'cashzombs@gmail.com'; }

    // Each user reads/writes only their own doc; the owner can read/manage all.
    // Users cannot escalate by changing their own email field to the owner's email.
    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.email == email();
      allow update: if isOwner()
                    || (request.auth.uid == uid
                        && request.resource.data.email == email());
      allow delete: if isOwner();
    }

    // Nexus CLI pairing codes: a signed-in user may create a one-time code ONLY
    // for their own account. No client may read, list, or update a code — it is
    // consumed server-side by the exchange endpoint (Admin SDK bypasses rules).
    // The user may delete their own pending code (e.g. to cancel it).
    match /pairings/{code} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == email();
      allow read, list, update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Announcements + settings: any signed-in user reads; only the owner writes.
    match /announcements/{docId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }
    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // Feedback / bug reports: any signed-in user submits; only the owner reads & manages.
    match /feedback/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if isOwner();
    }

    // Client error log: any signed-in user can report; only the owner reads & manages.
    match /errors/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if isOwner();
    }

    // Waitlist: anyone can submit their email (landing page, not signed in).
    // Only owner can read/manage. Limit fields to prevent abuse.
    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 256;
      allow read, update, delete: if isOwner();
    }
  }
}
