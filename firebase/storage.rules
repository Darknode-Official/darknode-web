rules_version = '2';
// Darknode Web - Storage access enforcement, deny-by-default backstop.
// The client ships no Firebase Storage SDK (installers live on GitHub Releases),
// so this is a safety net: only the super-admin (identified by the `admin` custom
// claim, same as Firestore) could ever read/write under /downloads. Reads the
// user's status from Firestore.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner()  { return signedIn() && request.auth.token.admin == true; }
    function isAllowed() {
      return isOwner() || (signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'allowed');
    }

    match /downloads/{allPaths=**} {
      allow read:  if isAllowed();
      allow write: if isOwner();
    }

    // Everything else: locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
